# ── InkOnce environment ─────────────────────────────────────────────
# Copy to .env.local for dev; set all of these in the Vercel project.

# ── Replicate (replicate.com/account/api-tokens) ────────────────────
# Primary renderer. Unlike the Higgsfield developer API — which exposes only
# the Soul family on this account — Replicate reaches FLUX, Seedream, Ideogram,
# nano-banana and tattoo-tuned SDXL. See lib/ai/router.ts for the model table.
#
# ⚠️ REQUIRES CREDIT. Below $5.00 balance Replicate throttles prediction
# creation to 6 requests/minute with a burst of 1 — strictly serial, which no
# multi-user studio can run on. Top up before pointing production at it.
REPLICATE_API_TOKEN=
# Webhook signing secret: GET https://api.replicate.com/v1/webhooks/default/secret
REPLICATE_WEBHOOK_SECRET=
# Optional per-task model overrides (see lib/ai/router.ts for defaults)
# INK_MODEL_DRAFT=
# INK_MODEL_REFINE=
# INK_MODEL_STENCIL=
# INK_MODEL_HIRES=

# Higgsfield platform API (cloud.higgsfield.ai → dashboard → API keys)
# Retained as the fallback renderer.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optional model overrides (see lib/higgsfield.ts for defaults)
# HF_MODEL_DRAFT=
# HF_MODEL_REFINE=
# HF_MODEL_STENCIL=

# Clerk (create a NEW Clerk app for InkOnce — do not reuse Almost Legal's)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Upstash Redis (create a NEW database for InkOnce)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Blob (auto-injected when the Blob store is attached to the project)
BLOB_READ_WRITE_TOKEN=

# Shared secret Higgsfield must echo back on generation webhooks
HF_WEBHOOK_SECRET=

# Canonical origin, no trailing slash
NEXT_PUBLIC_SITE_URL=https://inkonce.com
